# Copy to backend/.env
# JOBMATCH_DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch
# ANTHROPIC_API_KEY=sk-ant-...           # optional; enables Claude extraction and drafting
# JOBMATCH_API_TOKEN=change-me           # set when the API is reachable from the internet
# JOBMATCH_CORS_ORIGINS=http://localhost:3000
# JOBMATCH_ADZUNA_APP_ID=
# JOBMATCH_ADZUNA_APP_KEY=
# JOBMATCH_SCHEDULER=true                # daily ingest inside the API process
# JOBMATCH_INGEST_CRON_HOUR=7            # UTC
# JOBMATCH_ALERT_MIN_SCORE=70
